{
	"name": "osc-status",
	"version": "1.0.0",
	"description": "Report terminal program status with OSC 7501.",
	"keywords": [
		"osc",
		"osc7501",
		"progress",
		"status",
		"terminal"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonahsnider/osc-status.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"api:check": "pnpm build && api-extractor run",
		"api:update": "pnpm build && api-extractor run --local",
		"build": "vp pack",
		"check": "vp check",
		"format": "vp fmt --check",
		"format:fix": "vp fmt",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test run",
		"knip": "knip",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@microsoft/api-extractor": "7.59.4",
		"@tsconfig/recommended": "1.0.13",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.19.2",
		"knip": "6.41.0",
		"typescript": "7.0.2",
		"vite-plus": "1.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.11.2"
}
