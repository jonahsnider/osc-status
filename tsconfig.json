{
	"extends": ["@tsconfig/strictest", "@tsconfig/recommended"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"rewriteRelativeImportExtensions": true,
		"types": ["node"],
